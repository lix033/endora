{
  "name": "endora",
  "productName": "Endora",
  "version": "0.4.0",
  "description": "Client API de bureau open source : requêtes HTTP, collections, environnements, scripts, runner et génération de code.",
  "license": "MIT",
  "author": {
    "name": "lix033",
    "email": "julienkolou03@gmail.com"
  },
  "homepage": "https://github.com/lix033/endora#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lix033/endora.git"
  },
  "bugs": {
    "url": "https://github.com/lix033/endora/issues"
  },
  "keywords": [
    "api",
    "http",
    "rest",
    "client",
    "electron",
    "postman-alternative",
    "openapi",
    "graphql",
    "soap"
  ],
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "dist:mac": "npm run build && npm run licenses && electron-builder --mac",
    "dist:win": "npm run build && npm run licenses && electron-builder --win",
    "dist:linux": "npm run build && npm run licenses && electron-builder --linux",
    "brand": "node scripts/brand.mjs",
    "licenses": "node scripts/third-party.mjs",
    "dist": "npm run build && npm run licenses && electron-builder"
  },
  "dependencies": {
    "aws4": "^1.13.2",
    "curl-to-postmanv2": "^1.8.7",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.11.2",
    "graphql-to-postman": "^1.0.1",
    "jose": "^6.2.13",
    "js-yaml": "^4.3.0",
    "openapi-to-postmanv2": "^6.4.2",
    "postman-code-generators": "^2.1.1",
    "postman-collection": "^5.3.1",
    "postman-collection-transformer": "^4.1.14",
    "raml-to-postman": "^2.1.0",
    "raml1-to-postman": "^1.0.0",
    "swagger1-to-postman": "^1.1.3",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/aws4": "^1.11.6",
    "@types/chai": "^5.2.3",
    "@types/crypto-js": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "chai": "^6.3.0",
    "codemirror": "^6.0.2",
    "crypto-js": "^4.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lodash": "^4.18.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "raml-to-postman": {
      "uuid": "3.4.0"
